  {
    id: "form",
    nombre: "Form",
    grupo: "Formularios",
    desc: "Un formulario completo: Enter o el botón .submit() lo envían. Así se ven todos los campos juntos.",
    ejemplos: [
      {
        titulo: "Crear cuenta",
        codigo: 'import { Form, Input, PasswordInput, Select, Checkbox, Button, Card, toast, Toaster } from "tangerine-lang-ui"

struct Demo {
  @State var nombre = ""
  @State var correo = ""
  @State var clave = ""
  @State var pais = "co"
  @State var acepto = false
  @State var enviado = false

  fn error_correo() { if enviado && !correo.contains("@") { "Escribe un correo válido" } else { nil } }
  fn error_clave() { if enviado && clave.len() < 8 { "Mínimo 8 caracteres" } else { nil } }

  fn enviar() {
    enviado = true
    if error_correo() == nil && error_clave() == nil && acepto {
      toast("Cuenta creada para {nombre}", "success")
    }
  }

  view {
    Card("Crear cuenta", "Tarda un minuto").variant("elevated") {
      Form(|| enviar()) {
        Input("Nombre", $nombre).placeholder("Ana Pérez")
        Input("Correo", $correo, "email").placeholder("ana@correo.com").error(error_correo())
        PasswordInput("Contraseña", $clave).error(error_clave())
        Select("País", $pais, [["co", "Colombia"], ["mx", "México"], ["es", "España"]])
        Checkbox("Acepto los términos", $acepto)
        Button("Crear cuenta").submit().full()
      }
    }
    Toaster()
  }
}',
      },
    ],
    api: [
      ['Form(accion) { ... }', 'Llama a accion al enviar, con Enter o con un Button(...).submit().'],
    ],
  },
  {
    id: "password",
    nombre: "PasswordInput",
    grupo: "Formularios",
    desc: "Contraseña con un botón para mostrarla u ocultarla.",
    ejemplos: [
      {
        titulo: "Con fuerza de la contraseña",
        codigo: 'import { PasswordInput, Progress, Stack } from "tangerine-lang-ui"

struct Demo {
  @State var clave = ""

  fn fuerza() {
    var puntos = 0
    if clave.len() >= 8 { puntos += 40 }
    if clave.lower() != clave { puntos += 20 }
    if clave.chars().any(|c| "0123456789".contains(c)) { puntos += 20 }
    if clave.chars().any(|c| "!@#$%&*?".contains(c)) { puntos += 20 }
    puntos
  }

  view {
    Stack(12) {
      PasswordInput("Contraseña", $clave).placeholder("Escribe una contraseña").hint("Usa 8 caracteres, mayúsculas, números y símbolos")
      Progress(fuerza()).label("Seguridad")
    }
  }
}',
      },
    ],
    api: [
      ['PasswordInput(etiqueta, $campo)', 'El botón del ojo la muestra u oculta.'],
      ['.placeholder(t)  .hint(t)  .error(t)', 'Como en Input.'],
    ],
  },
